/* Generic sequence list type (compatible with asn_anonymous_sequence_) */
typedef struct X2AP_generic_seq {
    void **array;
    int count;
    int size;
} X2AP_generic_seq_t;

typedef struct X2AP_InitiatingNodeType_EndcX2Setup {
    long present;
    union {
        struct { X2AP_generic_seq_t list; } init_en_gNB;
